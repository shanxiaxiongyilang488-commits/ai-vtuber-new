{
	"name": "ai-vtuber",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "node tools/start-local-app.mjs main",
		"dev:web": "vite dev --host 127.0.0.1 --port 5173 --strictPort",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "svelte-check --tsconfig ./tsconfig.json",
		"test:aituber": "node --experimental-strip-types --test src/lib/aituber/aituber.test.ts",
		"test:comments": "node --experimental-strip-types --test src/lib/aituber/comments/comments.test.ts",
		"test:mouthpicker": "node --experimental-strip-types --test src/lib/mouth-picker/mouth-picker.test.ts",
		"test:image-organizer": "node --experimental-strip-types --test src/lib/mouth-picker/imageOrganizer.test.ts",
		"test:purupuru-materials": "node --experimental-strip-types --test src/lib/mouth-picker/purupuruMaterialCheck.test.ts",
		"test:purupuru": "node --experimental-strip-types --test src/lib/purupuru/purupuru.test.ts",
		"test:e2e": "playwright test",
		"test:e2e:voice": "playwright test tests/e2e/local-voice-tuning.spec.ts",
		"avatar:pngtuber": "npm --prefix aituber-onair/packages/core/examples/react-pngtuber-app run dev -- --host 127.0.0.1 --port 5181 --strictPort",
		"avatar:vrm": "npm --prefix aituber-onair/packages/core/examples/react-vrm-app run dev -- --host 127.0.0.1 --port 5182 --strictPort",
		"avatar:live2d": "npm --prefix aituber-onair/packages/core/examples/react-live2d-app run dev -- --host 127.0.0.1 --port 5183 --strictPort",
		"avatar:purupuru": "npm --prefix aituber-onair/packages/core/examples/react-purupuru-app run dev -- --host 127.0.0.1 --port 5184 --strictPort",
		"voice:bridge": "python\\voice_bridge\\run_voice_bridge.bat",
		"avatar:inochi2d": "npm --prefix aituber-onair/packages/core/examples/react-inochi2d-app run dev -- --host 127.0.0.1 --port 5185 --strictPort",
		"avatar:pet": "npm --prefix aituber-onair/packages/core/examples/react-pet-app run dev -- --host 127.0.0.1 --port 5186 --strictPort",
		"avatar:psd": "npm --prefix aituber-onair/packages/core/examples/react-psd-app run dev -- --host 127.0.0.1 --port 5187 --strictPort",
		"avatar:basic": "npm --prefix aituber-onair/packages/core/examples/react-basic run dev -- --host 127.0.0.1 --port 5188 --strictPort",
		"avatar:all": "node tools/start-avatar-labs.mjs",
		"live": "node tools/start-live2d-dev.mjs"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^25.5.0",
		"@types/three": "^0.183.1",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.2",
		"typescript": "^5.9.3",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"@mediapipe/tasks-vision": "^0.10.34",
		"@pixiv/three-vrm": "^3.5.1",
		"jszip": "^3.10.1",
		"marked": "^18.0.2",
		"openai": "^6.46.0",
		"three": "^0.183.2"
	}
}
